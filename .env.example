# ============================================================
# AURORA - ENVIRONMENT TEMPLATE
# Copy to .env and replace every placeholder locally.
# Never commit .env or backup copies with secrets.
# ============================================================

# Core AI
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Green API / WhatsApp
GREEN_API_INSTANCE=your_green_api_instance_here
GREEN_API_TOKEN=your_green_api_token_here
GREEN_API_SERVER=your_green_api_server_here

# Facebook / Instagram
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_TOKEN=your_facebook_page_token_here
INSTAGRAM_USER_ID=your_instagram_business_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Meta automation
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# JWT session auth
JWT_SECRET_KEY=change_me_to_a_random_secret_32_chars_min
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Server
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=5000
FASTAPI_ENV=production

# Logging
LOG_LEVEL=INFO
LOG_FILE=C:\\AURORA\\LOGS\\aurora.log
