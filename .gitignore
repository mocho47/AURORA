# .gitignore - Protege archivos sensibles

# Archivos de entorno
.env
.env.local
.env.*
!/.env.example

# Secretos de Meta (tokens/secret en texto plano) y respaldos del IDE
meta/
.ide_backups/

# Dependencias y cache de Python
*.pyc
__pycache__/
.pytest_cache/
.coverage
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
*.egg-info/

# Bases de datos
*.db
*.sqlite3

# Logs
LOGS/
logs/
*.log
*.tmp

# Archivos de build y distribución
build/
dist/
dist_atf/
dist_milens/
dist_venta/
*.spec

# Archivos de sistema operativo
.DS_Store
Thumbs.db

# Archivos de backup
*.bak
*.swp
*.swo
*~
BACKUPS/

# Paquetes Python instalados dentro de SUPER_MARKETING_SYSTEM (vendor)
# Solo se trackean los archivos de app, no las librerías instaladas
SUPER_MARKETING_SYSTEM/supabase_auth*/
SUPER_MARKETING_SYSTEM/supabase_functions*/
SUPER_MARKETING_SYSTEM/*.dist-info/
SUPER_MARKETING_SYSTEM/bin/
SUPER_MARKETING_SYSTEM/cffi*/
SUPER_MARKETING_SYSTEM/cryptography*/
SUPER_MARKETING_SYSTEM/dateutil/
SUPER_MARKETING_SYSTEM/deprecation*/
SUPER_MARKETING_SYSTEM/jwt/
SUPER_MARKETING_SYSTEM/multidict*/
SUPER_MARKETING_SYSTEM/packaging*/
SUPER_MARKETING_SYSTEM/propcache*/
SUPER_MARKETING_SYSTEM/pycparser*/
SUPER_MARKETING_SYSTEM/pyjwt*/
SUPER_MARKETING_SYSTEM/python_dateutil*/
SUPER_MARKETING_SYSTEM/six*
SUPER_MARKETING_SYSTEM/strenum*/
SUPER_MARKETING_SYSTEM/supafunc*/
SUPER_MARKETING_SYSTEM/typing_extensions*
SUPER_MARKETING_SYSTEM/typing_inspection*/
SUPER_MARKETING_SYSTEM/yarl*/
SUPER_MARKETING_SYSTEM/*.pyd
SUPER_MARKETING_SYSTEM/_cffi_backend*

# DB de memoria (generada en runtime)
MEMORIA/aurora_memoria.db

# Archivos de salida
EDITOR_OUT/
SUBLIMACION_OUT/
TALLER_OUT/
UPLOADS/
VIDEO/

# Archivos de configuración de IDE
.vscode/
.idea/

# Otros
node_modules/


# --- Añadido: datos de clientes y entradas (no van a GitHub) ---
*.db
*.db-wal
*.db-shm
ENTRADAS_CHAT/
SUBLIMACION_OUT/
AGENTES/

# Pruebas sueltas de sesiones de trabajo: no son del proyecto
scratchpad/

# Modelos de voz y demas binarios pesados: no van en un repo de codigo
MODELOS/

# --- Credenciales y datos personales: NUNCA a git (auditoria 2026-08-24) ---
# identidad.json guarda el hash y el salt del PIN de dueno, que da control
# total de la PC. Estuvo versionado desde el primer commit (23-jul-2026).
CONFIG/identidad.json
# contactos.json esta pensado para telefonos reales de familia y clientes.
CONFIG/contactos.json

# Fotos con fecha que deja el propio sistema al editar catalogos: son
# respaldos locales, no codigo. El respaldo diario ya los cubre.
CONFIG/*.bak-*.json
